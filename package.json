{
  "name": "gdg-ecosystem",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "node --experimental-strip-types --test tests/*.test.mts",
    "docs:build": "python -m mkdocs build",
    "docs:serve": "python -m mkdocs serve",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.10.4"
  }
}
