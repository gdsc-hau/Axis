# GDG Hub runtime. Copy to apps/gdg-hub/.env.local for local development.
# Use the publishable/anon key in NEXT_PUBLIC_* and never expose the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Exact public origin with no trailing slash. Local development uses port 3001.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Bevy event webhook. Keep inactive until the Hub has a public HTTPS URL.
BEVY_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
BEVY_WEBHOOK_SECRET_HEADER=x-axis-bevy-secret
BEVY_CHAPTER_ID=
BEVY_CHAPTER_SLUG=gdg-on-campus-holy-angel-university-angeles-philippines
