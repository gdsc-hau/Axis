# Supabase Shared Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres.your-supabase-url:password@aws-0-region.pooler.supabase.com:5432/postgres

# App Specific (axis-hub)
NEXT_PUBLIC_HUB_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# App Specific (id-platform)
NEXT_PUBLIC_ID_URL=http://localhost:3000

# Upstash Redis (if needed)
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# At least 32 random characters. Rotate this to invalidate all issued QR codes.
QR_SIGNING_SECRET=replace-with-a-cryptographically-random-secret
