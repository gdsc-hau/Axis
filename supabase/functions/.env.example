# Edge Function secrets. Set these in the hosted Supabase project, never in Git.
# Supabase supplies SUPABASE_URL plus SUPABASE_SECRET_KEYS (or the legacy
# SUPABASE_SERVICE_ROLE_KEY) to hosted functions.

# Keep both email delivery gates disabled until sender/provider acceptance passes.
AXIS_EMAIL_DELIVERY_ENABLED=false
AXIS_EMAIL_WORKER_SECRET=replace-with-at-least-32-random-characters
RESEND_API_KEY=re_your_resend_api_key
AXIS_EMAIL_FROM=GDG on Campus HAU <notifications@example.org>
